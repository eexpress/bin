# ------- xclip写入文件 -------
yy() {		#XA_CLIPBOARD
    f=${*:-y.剪贴板}
	echo $f
	xclip -selection clipboard -o > "$f"
	sed -i 's/\r$//' $f
}

y() {		#XA_PRIMARY
	f=${*:-x.摘录}
	echo $f
	echo -ne "#\t--------▶  " >>"$f"
	date '+%F %T' | tr -d '\n' >>"$f"
	echo -e " ◀ --------" >>"$f"
	xclip -o  | sed '/'$HOSTNAME'/c--------' >>"$f"
	echo -e "\n" >>"$f"
}

